{
  "name": "@eventuras/oratio-react",
  "version": "0.1.0",
  "description": "React hooks and components for the oratio Matrix client, on ratio-ui/chat",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/oratio.git",
    "directory": "packages/oratio-react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eventuras/oratio-core": "workspace:^"
  },
  "peerDependencies": {
    "@eventuras/ratio-ui": "^2.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eventuras/ratio-ui": "^2.25.0",
    "@eventuras/typescript-config": "^1.1.0",
    "@eventuras/vite-config": "^0.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
