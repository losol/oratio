{
  "name": "oratio",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/oratio.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset git-tag",
    "clean": "pnpm -r exec rm -rf dist build .turbo node_modules && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.2",
    "@eventuras/typescript-config": "^1.0.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  }
}
