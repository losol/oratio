{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Generated by changesets and pnpm: never format these.
      "!**/CHANGELOG.md",
      "!.changeset/*.md",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      // CI runs `biome ci --error-on-warnings` (as does `pnpm lint`), so every
      // rule in the preset is enforced, including the ones that only default to
      // "warn". Deliberate exceptions go inline as a `biome-ignore` comment that
      // says why, next to the code they cover.
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Same groups as historia and the simple-import-sort setup in
            // @eventuras/eslint-config.
            "groups": [
              ":NODE:",
              ["react", "react-*"],
              "@eventuras/**",
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  }
}
